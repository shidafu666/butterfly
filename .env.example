# ============================================================
# Butterfly - 电流数据采集与可视化平台
# Copy this file to .env and fill in values before starting
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app123
POSTGRES_DB=current_platform
DATABASE_URL=postgresql://app:app123@postgres:5432/current_platform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MQTT (Mosquitto) ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC=wlpca/+/data
MQTT_CLIENT_ID=current-platform-ingestion-worker

# --- Backend ---
PORT=3001
NODE_ENV=development
EXPORT_DIR=/app/exports

# Local JWT secret (generate a strong random string for production)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h

# Microsoft Entra ID (optional - leave empty to use local auth only)
JWT_AUDIENCE=
JWT_ISSUER=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Initial Admin Setup ---
# Used on first startup if no admin user exists
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME=Administrator
