# ============================================================
# CyberBee - 电流数据采集与可视化平台
# Copy this file to .env and fill in values before starting
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app123
POSTGRES_DB=current_platform
DATABASE_URL=postgresql://app:app123@postgres:5432/current_platform

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Azure Cache for Redis uses TLS port 6380 and requires a password.
# Leave REDIS_PASSWORD empty and REDIS_TLS unset for local Docker Compose Redis.
# REDIS_PASSWORD=
# REDIS_TLS=true

# --- MQTT (Mosquitto) ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC=wlpca/+/data
MQTT_CLIENT_ID=current-platform-ingestion-worker
# Broker authentication — sensors must use these credentials
MQTT_USERNAME=iot_device
MQTT_PASSWORD=change-me-mqtt-password
# External broker URL for test scripts (e.g. ACI endpoint)
BROKER_URL=mqtt://localhost:1883

# --- Ingestion Worker ---
# Max concurrent message handlers per worker instance (default: 10)
# Each in-flight handler holds one DB connection; keep ≤ DB_POOL_MAX.
INGESTION_CONCURRENCY=10
# pg connection pool size per worker instance (default: 20)
# When scaling to N replicas: ensure postgres max_connections > N × DB_POOL_MAX.
DB_POOL_MAX=20

# --- Backend ---
PORT=3001
# Sensor active threshold: sensors with no report within this many hours are considered Inactive
SENSOR_ACTIVE_THRESHOLD_HOURS=24
# Export job retention: jobs older than this many hours are automatically deleted (files + records)
EXPORT_JOB_RETENTION_HOURS=24
NODE_ENV=development
EXPORT_DIR=/app/exports

# Local JWT secret (generate a strong random string for production)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h

# Microsoft Entra ID (optional - leave all values empty to use local auth only)
COOKIE_SECRET=change-me-use-an-independent-random-string
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:3000/api/v1/auth/entra/callback
ENTRA_POST_LOGIN_REDIRECT=http://localhost:3000/auth/callback

# --- Frontend ---
# Browser requests use the same-origin /api proxy.
NEXT_PUBLIC_API_BASE_URL=
BACKEND_ORIGIN=http://localhost:3001

# --- Initial Admin Setup ---
# Used on first startup if no admin user exists
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME=Administrator
