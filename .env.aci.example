# ============================================================
# Butterfly — ACI 部署配置（Azure China 21Vianet）
# 复制为 .env.aci 并填写实际值:  cp .env.aci.example .env.aci
# 然后执行:  make aci-all
# ============================================================

# ─── Azure 订阅 & 资源组 ──────────────────────────────────────
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_LOCATION=chinaeast2

# ─── Azure Container Registry（已有） ─────────────────────────
ACR_NAME=<your-acr-name>
ACR_LOGIN_SERVER=<your-acr-name>.azurecr.cn   # az acr show --name <acr> --query loginServer -o tsv

# ─── Azure Storage File Share（已有，用于 backend/export-worker 共享导出卷）
AZURE_STORAGE_ACCOUNT=<your-storage-account-name>
AZURE_STORAGE_KEY=<your-storage-account-key>
AZURE_FILE_SHARE_NAME=butterfly-exports

# ─── ACI 容器组 ───────────────────────────────────────────────
ACI_CONTAINER_GROUP_NAME=butterfly
ACI_DNS_LABEL=butterfly
ACI_RESTART_POLICY=Always

# ─── Azure PostgreSQL Flexible Server（已有） ─────────────────
# 服务器名称（用于 Azure CLI 配置 TimescaleDB 扩展）
PG_SERVER_NAME=<your-pg-server-name>
# 完整连接字符串（sslmode=require 是 Azure PG 必需的）
# ⚠️ 值中包含 & 等特殊字符时必须用双引号包裹
DATABASE_URL="postgresql://<user>:<password>@<server>.postgres.database.chinacloudapi.cn:5432/<database>?sslmode=require"

# ─── MQTT（Mosquitto 容器内认证） ─────────────────────────────
MQTT_USERNAME=iot_device
MQTT_PASSWORD=<your-mqtt-password>

# ─── Backend ──────────────────────────────────────────────────
JWT_SECRET=<your-jwt-secret-run-openssl-rand-hex-64>
COOKIE_SECRET=<your-cookie-secret-run-openssl-rand-hex-64>
JWT_EXPIRES_IN=24h
SENSOR_ACTIVE_THRESHOLD_HOURS=24
EXPORT_JOB_RETENTION_HOURS=24

# ─── Frontend Web App ─────────────────────────────────────────
AZURE_WEBAPP_NAME=<your-webapp-name>
# Next.js 服务端同源代理访问 ACI API；开发阶段为公网 HTTP。
BACKEND_ORIGIN=http://<aci-dns-label>.<location>.azurecontainer.console.azure.cn:3001

# ─── Initial Admin（首次启动自动创建） ────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<your-admin-password>
INITIAL_ADMIN_NAME=Administrator

# ─── Ingestion Worker ────────────────────────────────────────
INGESTION_CONCURRENCY=10
DB_POOL_MAX=20

# ─── Microsoft Entra ID SSO（全球区、单租户；可选）────────────
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=https://<your-webapp-name>.chinacloudsites.cn/api/v1/auth/entra/callback
ENTRA_POST_LOGIN_REDIRECT=https://<your-webapp-name>.chinacloudsites.cn/auth/callback

# ─── 镜像 Tag（可选）──────────────────────────────────────────
# 默认自动使用 git SHA；dirty worktree 会加时间戳，确保 ACI 滚到新镜像。
# 如需固定标签，请在命令行显式传入，而不是写进 .env.aci:
# IMAGE_TAG=my-release make aci-all
