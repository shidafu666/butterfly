# ============================================================
# Butterfly — Azure 全栈部署配置（Azure China 21Vianet）
# 复制为 .env.azure 并填写实际值:  cp .env.azure.example .env.azure
# 然后执行:  make azure-all
# ============================================================

# ─── Azure 订阅 & 应用资源组 ──────────────────────────────────
AZURE_SUBSCRIPTION_ID=28fa79ec-79c6-4499-ad0a-19b93a92ae90
AZURE_RESOURCE_GROUP=rg-cn-p-app-10011222
AZURE_LOCATION=chinaeast2

# ─── Azure Container Registry ────────────────────────────────
ACR_NAME=cyberbee
ACR_LOGIN_SERVER=cyberbee.azurecr.cn

# ─── Web App (frontend + backend 合并镜像) ────────────────────
AZURE_WEBAPP_NAME=cyberbee

# ─── Container Apps (ingestion-worker + export-worker) ───────
CONTAINER_APP_NAME=cyberbee-services
CONTAINER_APP_ENV=cyberbee-conatiner-apps-env

# ─── MQTT ACI (仅 Mosquitto) ─────────────────────────────────
ACI_MQTT_NAME=dev-butterfly
ACI_DNS_LABEL=dev-butterfly
ACI_RESTART_POLICY=Always
# ACI 只在 chinaeast2 和 chinanorth3 可用，与其他资源 region 不同时单独设置:
# ACI_LOCATION=chinanorth3

# ─── Azure Cache for Redis ────────────────────────────────────
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD 由脚本在部署时从 Azure CLI 获取，
# 不写入此文件，避免明文密钥受版本控制。
REDIS_CACHE_NAME=cyberbee

# ─── Azure Storage ────────────────────────────────────────────
# AZURE_STORAGE_KEY 由脚本在部署时从 Azure CLI 获取。
AZURE_STORAGE_ACCOUNT=cyberbeestorage
AZURE_FILE_SHARE_NAME=butterfly-exports

# ─── PostgreSQL（旧资源组，不迁移数据）────────────────────────
# 数据库服务器所在的资源组（可与应用资源组不同）
PG_RESOURCE_GROUP=<pg-server-resource-group>
PG_SERVER_NAME=butterfly-pg
# ⚠️ 连接字符串包含特殊字符时必须用双引号包裹
DATABASE_URL="postgresql://<user>:<password>@<server>.postgres.database.chinacloudapi.cn:5432/<database>?sslmode=require"

# ─── MQTT 凭据 ────────────────────────────────────────────────
MQTT_USERNAME=iot_device
MQTT_PASSWORD=<your-mqtt-password>
# ingestion-worker 连接 Mosquitto ACI 的 URL（部署 ACI 后填写 FQDN）:
# MQTT_URL=mqtt://dev-butterfly.chinanorth3.azurecontainer.console.azure.cn:1883
MQTT_URL=mqtt://<dev-butterfly-fqdn>:1883

# ─── 后端密钥 ─────────────────────────────────────────────────
JWT_SECRET=<run: openssl rand -hex 64>
COOKIE_SECRET=<run: openssl rand -hex 64>
JWT_EXPIRES_IN=24h
SENSOR_ACTIVE_THRESHOLD_HOURS=24
EXPORT_JOB_RETENTION_HOURS=24

# ─── 初始管理员账号 ───────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<your-admin-password>
INITIAL_ADMIN_NAME=Administrator

# ─── Worker 并发配置 ──────────────────────────────────────────
INGESTION_CONCURRENCY=10
DB_POOL_MAX=20

# ─── Microsoft Entra ID SSO（可选）───────────────────────────
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# 生产回调地址（需与 Entra App Registration 中配置一致）:
ENTRA_REDIRECT_URI=https://cyberbee.chinacloudsites.cn/api/v1/auth/entra/callback
ENTRA_POST_LOGIN_REDIRECT=https://cyberbee.chinacloudsites.cn/auth/callback

# ─── 镜像 Tag（可选）────────────────────────────────────────
# 默认自动使用 git SHA；如需固定标签，在命令行传入而不是写进此文件:
# IMAGE_TAG=my-release make azure-all
